{
  "name": "silan-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-dev-server.mjs",
    "build": "tsc && vite build",
    "test": "npm run test:resource-visibility && npm run test:cover-generation && npm run test:language-review && npm run test:editor-workflows",
    "test:cover-generation": "node --experimental-strip-types --test src/lib/coverGeneration.test.mjs",
    "test:resource-visibility": "node --experimental-strip-types --test src/lib/resourceVisibility.test.mjs",
    "test:language-review": "node --experimental-strip-types --test src/lib/languageReviewWorkflow.test.mjs",
    "test:editor-workflows": "node --experimental-strip-types --test src/lib/markdownBlockDiff.test.mjs src/lib/translationSyncWorkflow.test.mjs",
    "generate:icon": "python3 scripts/generate_icon.py && tauri icon src-tauri/icons/app-icon.png",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "build:desktop": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.441.0",
    "novel": "^1.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tiptap-markdown": "^0.8.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
